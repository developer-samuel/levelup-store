{
  "type": "project",
  "license": "proprietary",
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require": {
    "php": ">=8.2 <8.4",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "async-aws/s3": "*",
    "developer-samuel/php-codestats": "^1.1",
    "doctrine/dbal": "^3",
    "doctrine/doctrine-bundle": "^2.13",
    "doctrine/doctrine-migrations-bundle": "^3.4",
    "doctrine/orm": "^3.6",
    "dragonmantank/cron-expression": "^3.6",
    "elasticsearch/elasticsearch": "^8",
    "knplabs/knp-snappy-bundle": "^1.10",
    "league/flysystem-aws-s3-v3": "*",
    "league/flysystem-bundle": "*",
    "lexik/jwt-authentication-bundle": "^3.2",
    "nelmio/cors-bundle": "^2.5",
    "paragonie/sodium_compat": "^2.1",
    "pentatrion/vite-bundle": "^8.1",
    "phpdocumentor/reflection-docblock": "^5.6",
    "phpstan/phpdoc-parser": "^2.1",
    "predis/predis": "^3.0",
    "sentry/sentry-symfony": "^5.10",
    "snc/redis-bundle": "^4.9",
    "stripe/stripe-php": "19.1",
    "symfony/amqp-messenger": "7.4.*",
    "symfony/asset": "7.4.*",
    "symfony/asset-mapper": "7.4.*",
    "symfony/console": "7.4.*",
    "symfony/doctrine-messenger": "7.4.*",
    "symfony/dotenv": "7.4.*",
    "symfony/expression-language": "7.4.*",
    "symfony/filesystem": "7.4.*",
    "symfony/flex": "^2",
    "symfony/form": "7.4.*",
    "symfony/framework-bundle": "7.4.*",
    "symfony/http-client": "7.4.*",
    "symfony/http-foundation": "7.4.*",
    "symfony/http-kernel": "7.4.*",
    "symfony/intl": "7.4.*",
    "symfony/mailer": "7.4.*",
    "symfony/mercure-bundle": "^0.5.0",
    "symfony/messenger": "7.4.*",
    "symfony/mime": "7.4.*",
    "symfony/monolog-bundle": "^3.0",
    "symfony/notifier": "7.4.*",
    "symfony/password-hasher": "7.4.*",
    "symfony/process": "7.4.*",
    "symfony/property-access": "7.4.*",
    "symfony/property-info": "7.4.*",
    "symfony/runtime": "7.4.*",
    "symfony/scheduler": "7.4.*",
    "symfony/security-bundle": "7.4.*",
    "symfony/serializer": "7.4.*",
    "symfony/stimulus-bundle": "^2.23",
    "symfony/string": "7.4.*",
    "symfony/translation": "7.4.*",
    "symfony/twig-bundle": "7.4.*",
    "symfony/ux-turbo": "^2.23",
    "symfony/validator": "7.4.*",
    "symfony/web-link": "7.4.*",
    "symfony/yaml": "7.4.*",
    "twig/extra-bundle": "^2.12|^3.0",
    "twig/twig": "^3.22"
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true,
      "symfony/flex": true,
      "symfony/runtime": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "infection/extension-installer": true
    },
    "bump-after-update": true,
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/",
      "Database\\Fixtures\\": "database/fixtures/",
      "Database\\Macros\\": "database/macros/",
      "Database\\Seeds\\Abstract\\": "database/seeds/Abstract/",
      "Database\\Seeds\\Behavior\\": "database/seeds/Behavior/",
      "Database\\Seeds\\Builders\\": "database/seeds/Builders/",
      "Database\\Seeds\\Factories\\": "database/seeds/Factories/",
      "Database\\Seeds\\Records\\": "database/seeds/Records/",
      "Database\\Seeds\\Utils\\": "database/seeds/Utils/",
      "Database\\Schemas\\": "database/schemas/",
      "Database\\Types\\": "database/types/",
      "Database\\Validators\\": "database/validators/",
      "Kit\\": "kit/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "replace": {
    "symfony/polyfill-ctype": "*",
    "symfony/polyfill-iconv": "*",
    "symfony/polyfill-php72": "*",
    "symfony/polyfill-php73": "*",
    "symfony/polyfill-php74": "*",
    "symfony/polyfill-php80": "*",
    "symfony/polyfill-php81": "*",
    "symfony/polyfill-php82": "*"
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd",
      "importmap:install": "symfony-cmd"
    },
    "post-install-cmd": [
      "Composer\\Config::disableProcessTimeout",
      "bin/run php scripts/symfony/env-generate/launcher.php",
      "bin/run php scripts/symfony/env-secret/launcher.php",
      "bin/run php scripts/symfony/jwt-generate/launcher.php",
      "bin/run php scripts/tasks/prepare-var/launcher.php",
      "bin/run php scripts/tasks/set-permissions/launcher.php",
      "@auto-scripts",
      "bin/run php scripts/tasks/prepare-temp/launcher.php",
      "bin/run php scripts/tasks/prepare-assets/launcher.php",
      "bin/run php scripts/tasks/generate-uml/launcher.php"
    ],
    "post-update-cmd": [
      "Composer\\Config::disableProcessTimeout",
      "bin/run php scripts/tasks/prepare-var/launcher.php",
      "bin/run php scripts/tasks/set-permissions/launcher.php",
      "@auto-scripts",
      "bin/run php scripts/tasks/prepare-temp/launcher.php",
      "bin/run php scripts/tasks/prepare-assets/launcher.php"
    ],
    "env:generate": [
      "Composer\\Config::disableProcessTimeout",
      "bin/run php scripts/symfony/env-generate/launcher.php"
    ],
    "env:secret": [
      "Composer\\Config::disableProcessTimeout",
      "bin/run php scripts/symfony/env-secret/launcher.php"
    ],
    "secrets:generate": [
      "Composer\\Config::disableProcessTimeout",
      "bin/run php bin/console secrets:generate-keys"
    ],
    "jwt:generate": [
      "Composer\\Config::disableProcessTimeout",
      "bin/run php scripts/symfony/jwt-generate/launcher.php"
    ],
    "var:prepare": [
      "Composer\\Config::disableProcessTimeout",
      "bin/run php scripts/tasks/prepare-var/launcher.php"
    ],
    "permissions:set": [
      "Composer\\Config::disableProcessTimeout",
      "bin/run php scripts/tasks/set-permissions/launcher.php"
    ],
    "temp:prepare": [
      "Composer\\Config::disableProcessTimeout",
      "bin/run php scripts/tasks/prepare-temp/launcher.php"
    ],
    "assets:prepare": [
      "Composer\\Config::disableProcessTimeout",
      "bin/run php scripts/tasks/prepare-assets/launcher.php"
    ],
    "uml:generate": [
      "Composer\\Config::disableProcessTimeout",
      "bin/run php scripts/tasks/generate-uml/launcher.php"
    ],
    "cache:clear": [
      "Composer\\Config::disableProcessTimeout",
      "bin/run php bin/console cache:clear"
    ],
    "cache:warmup": [
      "Composer\\Config::disableProcessTimeout",
      "bin/run php bin/console cache:warmup"
    ],
    "db-setup": [
      "Composer\\Config::disableProcessTimeout",
      "bin/run php scripts/symfony/database/launcher.php"
    ],
    "elasticsearch:reindex": [
      "Composer\\Config::disableProcessTimeout",
      "bin/run php bin/console app:elasticsearch:reindex"
    ],
    "scheduler:run": [
      "Composer\\Config::disableProcessTimeout",
      "bin/run php bin/console messenger:consume scheduler_default"
    ],
    "deptrac": [
      "Composer\\Config::disableProcessTimeout",
      "bin/run php scripts/tools/deptrac/launcher.php"
    ],
    "php-md": [
      "Composer\\Config::disableProcessTimeout",
      "bin/run php vendor/bin/phpmd src kit xml phpmd.xml"
    ],
    "php-stan": [
      "Composer\\Config::disableProcessTimeout",
      "bin/run php vendor/bin/phpstan analyse --memory-limit=1G"
    ],
    "php-cpd": [
      "Composer\\Config::disableProcessTimeout",
      "bin/run php vendor/bin/phpcpd src database kit"
    ],
    "php-loc": [
      "Composer\\Config::disableProcessTimeout",
      "bin/run php vendor/bin/phploc src database kit"
    ],
    "php-metrics": [
      "Composer\\Config::disableProcessTimeout",
      "bin/run php scripts/tools/php-metrics/launcher.php"
    ],
    "pdepend": [
      "Composer\\Config::disableProcessTimeout",
      "bin/run php scripts/tools/pdepend/launcher.php"
    ],
    "php-cs-fixer:fix": [
      "Composer\\Config::disableProcessTimeout",
      "bin/run php scripts/tools/php-cs-fixer/launcher.php"
    ],
    "rector:fix": [
      "Composer\\Config::disableProcessTimeout",
      "bin/run php vendor/bin/rector process"
    ],
    "php-unit": [
      "Composer\\Config::disableProcessTimeout",
      "bin/run php scripts/tools/php-unit/launcher.php"
    ],
    "sonar": [
      "Composer\\Config::disableProcessTimeout",
      "bin/run php scripts/tools/sonar/launcher.php"
    ],
    "lint:twig": [
      "Composer\\Config::disableProcessTimeout",
      "bin/run php bin/console lint:twig templates/"
    ],
    "count-stats": [
      "Composer\\Config::disableProcessTimeout",
      "bin/run php vendor/bin/count-stats"
    ],
    "count-files": [
      "Composer\\Config::disableProcessTimeout",
      "bin/run php vendor/bin/count-files"
    ],
    "count-lines": [
      "Composer\\Config::disableProcessTimeout",
      "bin/run php vendor/bin/count-lines"
    ],
    "count-chars": [
      "Composer\\Config::disableProcessTimeout",
      "bin/run php vendor/bin/count-chars"
    ],
    "serve": [
      "Composer\\Config::disableProcessTimeout",
      "php -S 127.0.0.1:8000 -t public"
    ]
  },
  "conflict": {
    "symfony/symfony": "*"
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "7.4.*"
    }
  },
  "require-dev": {
    "deptrac/deptrac": "^4.4",
    "doctrine/doctrine-fixtures-bundle": "^4.1",
    "friendsofphp/php-cs-fixer": "^3.92",
    "pdepend/pdepend": "^2.16",
    "phploc/phploc": "^7.0",
    "phpmd/phpmd": "^2.15",
    "phpmetrics/phpmetrics": "^2.9",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-symfony": "^2.0",
    "phpunit/phpunit": "^9.6",
    "rector/rector": "^2.5",
    "sebastian/phpcpd": "^6.0",
    "symfony/browser-kit": "7.4.*",
    "symfony/css-selector": "7.4.*",
    "symfony/debug-bundle": "7.4.*",
    "symfony/maker-bundle": "^1.0",
    "symfony/phpunit-bridge": "^7.4",
    "symfony/stopwatch": "7.4.*",
    "symfony/web-profiler-bundle": "7.4.*"
  }
}
