{
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "developer-samuel/php-codestats": "^1.1"
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true,
      "tbachert/spi": true,
      "phpstan/extension-installer": true,
      "symfony/flex": true,
      "symfony/runtime": true
    }
  },
  "scripts": {
    "post-install-cmd": [
      "@composer install -d apps/ecommerce --no-interaction --prefer-dist --optimize-autoloader --ignore-platform-req=ext-opentelemetry"
    ],
    "post-update-cmd": [
      "@composer update -d apps/ecommerce --no-interaction --prefer-dist --optimize-autoloader --ignore-platform-req=ext-opentelemetry"
    ],
    "env:generate": [
      "Composer\\Config::disableProcessTimeout",
      "php scripts/env-generate/launcher.php"
    ],
    "count-stats": [
      "Composer\\Config::disableProcessTimeout",
      "php vendor/bin/count-stats"
    ],
    "count-files": [
      "Composer\\Config::disableProcessTimeout",
      "php vendor/bin/count-files"
    ],
    "count-lines": [
      "Composer\\Config::disableProcessTimeout",
      "php vendor/bin/count-lines"
    ],
    "count-chars": [
      "Composer\\Config::disableProcessTimeout",
      "php vendor/bin/count-chars"
    ]
  }
}
