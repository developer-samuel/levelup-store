##########################################################################
#                                                                        #
#                         🛠️ ACTIVE SETTINGS 🛠️                         #
#                                                                        #
##########################################################################

# ╭────────────────────────╮
#  ⚙️ Application Settings
# ╰────────────────────────╯
APP_ENV=test
APP_DEBUG=0
APP_URL=http://127.0.0.1:8000

# ╭───────────────────╮
#  🛡️ Security & CORS
# ╰───────────────────╯

# 🌐 Trusted proxy IPs - ensures correct client IP resolution behind reverse proxies / load balancers
TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR

# 🔒 Allowed CORS origins - regex pattern matched against the request Origin header
CORS_ALLOW_ORIGIN='.*'

# ╭───────────────────╮
#  🗄️ Database Config
# ╰───────────────────╯
# Doctrine appends '_test' suffix automatically (doctrine.yaml → dbname_suffix).
# Real DB used by tests: levelup_store_test

### 👉 PostgreSQL (default)
SERVER_VERSION=17

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=levelup_store
DB_USERNAME=postgres
DB_PASSWORD=secret
DATABASE_URL=$DB_CONNECTION://$DB_USERNAME:$DB_PASSWORD@$DB_HOST:$DB_PORT/$DB_DATABASE

### 👉 MySQL (uncomment to use instead)
#SERVER_VERSION=8.0.42-MySQL

#DB_HOST=127.0.0.1
#DB_PORT=3306
#DB_DATABASE=levelup_store
#DB_USERNAME=root
#DB_PASSWORD=
#DATABASE_URL=mysql://$DB_USERNAME:$DB_PASSWORD@$DB_HOST:$DB_PORT/$DB_DATABASE?serverVersion=$SERVER_VERSION

# ╭───────────────────────────────╮
#  🔍 Elasticsearch Configuration
# ╰───────────────────────────────╯
ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200

# ╭───────────────────────╮
#  🧰 Redis Configuration
# ╰───────────────────────╯
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://$REDIS_HOST:$REDIS_PORT

# ╭───────────────────────╮
#  🗄️ MinIO Configuration
# ╰───────────────────────╯
MINIO_ENABLED=true
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_PUBLIC_URL=http://127.0.0.1:9000
MINIO_BUCKET=levelup-store

# ╭───────────────────────╮
#  📋 Audit Configuration
# ╰───────────────────────╯
AUDIT_LOGS_ENABLED=true

# ╭────────────────────────────╮
#  📊 Monitoring Configuration
# ╰────────────────────────────╯
SENTRY_DSN=

# ╭───────────────────────────────╮
#  🐇 RabbitMQ Settings
# ╰───────────────────────────────╯
RABBITMQ_ENABLED=true
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_VHOST=/

# ╭───────────────────────────────╮
#  🚀 Messenger / Queue Transport
# ╰───────────────────────────────╯
#
# ⚠️ RABBITMQ_ENABLED controls which transport is used:
# RABBITMQ_ENABLED=true  → set MESSENGER_TRANSPORT_DSN to amqp://
# RABBITMQ_ENABLED=false → set MESSENGER_TRANSPORT_DSN to doctrine://
#
MESSENGER_TRANSPORT_DSN=amqp://${RABBITMQ_USER}:${RABBITMQ_PASS}@${RABBITMQ_HOST}:${RABBITMQ_PORT}/${RABBITMQ_VHOST}

# ╭────────────────────────────────────╮
#  📡 Mercure Real-time Configuration
# ╰────────────────────────────────────╯
MERCURE_ENABLED=true
MERCURE_URL=http://127.0.0.1:3000/.well-known/mercure
MERCURE_PUBLIC_URL=http://127.0.0.1:3000/.well-known/mercure
MERCURE_CORS_ORIGINS=*
MERCURE_JWT_SECRET=


# ╭─────────────────╮
#  📩 Mail Settings
# ╰─────────────────╯
MAILER_DSN=null://null

# ╭──────────────────╮
#  💳 Stripe Payment
# ╰──────────────────╯
STRIPE_SECRET=test

# ╭──────────────────────╮
#  🔑 JWT Authentication
# ╰──────────────────────╯
JWT_TTL=900
JWT_REFRESH_TTL=2592000

# ╭─────────────────────╮
#  🌍 External API URLs
# ╰─────────────────────╯
API_COUNTRY_URL=https://www.apicountries.com/countries

# ╭─────────────────────────╮
#  👤 Test User Credentials
# ╰─────────────────────────╯
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=Test123@
