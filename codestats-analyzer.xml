<?xml version="1.0" encoding="UTF-8"?>
<analyzer>
    <file_extensions>
        <ext>php</ext>
        <ext>ts</ext>
        <ext>scss</ext>
        <ext>twig</ext>
        <ext>yaml</ext>
        <ext>sh</ext>
    </file_extensions>
    <ignored_dirs>
        <dir>public</dir>
        <dir>node_modules</dir>
        <dir>var</dir>
        <dir>vendor</dir>
    </ignored_dirs>
</analyzer>
