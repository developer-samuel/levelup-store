# Copy to backend.config.hcl and fill in the values.
# secrets/ is in .gitignore - never commit.
# Usage: make tf-init-remote
#
# namespace: OCI Console → Object Storage → top of page → "Namespace"
# region: must match TF_VAR_region in .env

bucket   = "YOUR_BUCKET_NAME"
key      = "oracle/terraform.tfstate"
region   = "YOUR_REGION"
endpoint = "https://YOUR_NAMESPACE.compat.objectstorage.YOUR_REGION.oraclecloud.com"

skip_region_validation      = true
skip_credentials_validation = true
skip_metadata_api_check     = true
force_path_style            = true
