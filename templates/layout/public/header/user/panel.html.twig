{% macro render() %}
    <div class="header__main-panel">
        {% if app.user %}
            <div class="header__main-user">
                <div class="header__main-user-icon">
                    <img
                        src="{{ asset('img/icons/app/user.png') }}"
                        alt="User"
                    >
                </div>
            </div>
        {% else %}
            <a href="{{ path('login') }}" class="header__main-login">
                <div class="header__main-login-icon">
                    <img
                        src="{{ asset('img/icons/app/user.png') }}"
                        alt="User"
                    >
                </div>
                <span class="header__main-login-text">
                    Login
                </span>
            </a>
        {% endif %}

        <div id="cart-icon" class="header__main-cart">
            <div class="header__main-cart-count">
                <span id="header-cart-count">
                    {{ totalItems is defined and totalItems >= 10 ? '9+' : (totalItems ?? 0) }}
                </span>
            </div>
            <img
                src="{{ asset('img/icons/app/cart.png') }}"
                alt="Cart"
                class="header__main-cart-icon"
            >
        </div>
    </div>
{% endmacro %}
