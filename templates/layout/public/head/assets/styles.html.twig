{% macro render() %}
    {% block stylesheets %}
        {% if ai_assistant_enabled %}
            <link rel="stylesheet" href="/build/assistant/chat.css">
        {% endif %}
        {% if block('stylesheets') is defined %}
            {{ vite_entry_link_tags('styles') }}
        {% else %}
            <link rel="stylesheet" href="{{ asset('build/styles.css') }}">
        {% endif %}
    {% endblock %}
{% endmacro %}
