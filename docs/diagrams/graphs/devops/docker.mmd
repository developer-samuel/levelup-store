graph TD
    %% Subgraph styles
    style DatabaseCache fill:#eceff1, stroke:#000, stroke-width:2px;
    style MessageBroker fill:#eceff1, stroke:#000, stroke-width:2px;
    style App fill:#eceff1, stroke:#000, stroke-width:2px;
    style Web fill:#eceff1, stroke:#000, stroke-width:2px;
    style Monitoring fill:#eceff1, stroke:#000, stroke-width:2px;

    %% Class Styles
    classDef docker fill:#000, color:#fff;
    classDef database_cache fill:#0637c0, color:#fff, stroke:#000, stroke-width:2px;
    classDef app fill:#e90d0d, color:#fff, stroke:#000, stroke-width:2px;
    classDef web fill:#8e44ad, color:#fff, stroke:#000, stroke-width:2px;
    classDef monitoring fill:#27ae60, color:#fff, stroke:#000, stroke-width:2px;

    %% Root
    Docker[🐳 Docker Containers]:::docker

    %% ----------------------------------------
    %% Subgraphs
    %% ----------------------------------------

    %% Databases
    subgraph DatabaseCache["Database, Search, Cache"]
        Postgres[🟦 PostgreSQL 17]
        Elasticsearch[🔍 Elasticsearch]
        Redis[🟧 Redis]
    end

    %% Message Broker
    subgraph MessageBroker["Message Broker"]
        RabbitMQ[🐇 RabbitMQ]
    end

    %% App Layer
    subgraph App["Application"]
        AppMain[🟪 PHP App]
        AppSetup[🟪 App Setup]
        Cron[⏱️ Cron/Scheduler]
        Worker[⚙️ Messenger Worker]
    end

    %% Web Layer
    subgraph Web["Web & Frontend"]
        Nginx[🟩 Nginx]
        Vite[🟨 Vite Frontend Builder]
    end

    %% Admin / Monitoring
    subgraph Monitoring["Monitoring & Admin"]
        PgAdmin[📘 pgAdmin]
        Elasticvue[🔎 Elasticvue]
        Prometheus[📊 Prometheus]
        Grafana[📊 Grafana]
    end

    %% Classes
    class Postgres,Elasticsearch,Redis database_cache;
    class AppMain,AppSetup,Cron,Worker app;
    class Nginx,Vite web;
    class PgAdmin,Prometheus,Grafana,Elasticvue monitoring;

    %% Connections
    Docker --> DatabaseCache
    Docker --> MessageBroker
    Docker --> App
    Docker --> Web
    Docker --> Monitoring

    %% App reads from data stores
    Postgres --> AppMain
    Elasticsearch --> AppMain
    Redis --> AppMain

    %% App publishes messages to broker
    AppMain --> RabbitMQ

    %% Worker consumes from broker and indexes to Elasticsearch
    RabbitMQ --> Worker
    Worker --> Elasticsearch

    %% Setup & web
    AppSetup --> Postgres
    AppMain --> Cron
    Nginx --> AppMain

    %% Admin & monitoring
    PgAdmin --> Postgres
    Elasticvue --> Elasticsearch
    Prometheus --> Grafana
