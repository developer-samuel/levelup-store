    Ingress    --> MinIO
    Ingress    --> ArgoCD
    Ingress    --> Grafana
    Ingress    --> Atlantis

    App --> DB
    App --> Search
    App --> Cache
    App --> MinIO
    App --> Queue
    App --> Mercure
    App --> OTel
    App --> Stripe
    App --> Mailer
    App --> Turnstile
    App --> CountryAPI
    App --> Sentry

    Queue  --> Worker
    KEDA   --> Worker
    Worker --> Search
    Worker --> DB
    Worker --> OTel

    Mercure --> Browser
    Cron    --> App

    OTel       --> Tempo
    OTel       --> Loki
    Prometheus --> AlertManager
    Prometheus --> Grafana
    Loki       --> Grafana
