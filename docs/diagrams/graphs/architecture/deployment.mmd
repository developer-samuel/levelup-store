graph TD
    %% CI/CD deployment pipeline - GitHub Actions
    %% deploy.yml: parallel ecommerce + assistant pipelines → shared sync
    %% ecommerce-ci.yml + assistant-ci.yml run independently (not gates)

    classDef trigger  fill:#000,    color:#fff, stroke:#000, stroke-width:2px;
    classDef ci       fill:#1a7f5a, color:#fff, stroke:#000, stroke-width:2px;
    classDef build    fill:#0637c0, color:#fff, stroke:#000, stroke-width:2px;
    classDef security fill:#c0392b, color:#fff, stroke:#000, stroke-width:2px;
    classDef sbom     fill:#8e44ad, color:#fff, stroke:#000, stroke-width:2px;
    classDef registry fill:#8e44ad, color:#fff, stroke:#000, stroke-width:2px;
    classDef gitops   fill:#e67e22, color:#fff, stroke:#000, stroke-width:2px;

    Push[🚀 git push → main]:::trigger

    %% ── Independent CI (not gates) ───────────────────────────────────────────

    subgraph EcommerceCIWorkflow["ecommerce-ci.yml  (independent)"]
        Lint[🔍 PHP-CS-Fixer\nESLint + Stylelint]:::ci
        PHPUnit[🧪 PHPUnit\nUnit + Integration]:::ci
        Vitest[🧪 Vitest\nUnit + Integration]:::ci
        Playwright[🎭 Playwright\nEnd-to-end]:::ci
    end

    subgraph AssistantCIWorkflow["assistant-ci.yml  (independent)"]
        AiLint[🔍 Ruff lint\nMypy + Vulture]:::ci
        AiFrontendLint[🔍 ESLint\nTypeScript type-check]:::ci
    end

    %% ── deploy.yml ───────────────────────────────────────────────────────────

    subgraph DeployWorkflow["deploy.yml"]

        subgraph EcommerceTrack["Ecommerce track  (parallel)"]
            BuildEcommerce[🐳 build-ecommerce\nDockerfile.prod · amd64+arm64]:::build
            GHCREcommerce[📦 push → GHCR\n*-ecommerce]:::registry
            SbomEcommerce[📋 sbom-ecommerce\nSyft + GitHub Attestation]:::sbom
            ScanEcommerce[🔒 scan-ecommerce\nTrivy CRITICAL+HIGH + SARIF]:::security
            SignEcommerce[✍️ sign-ecommerce\ncosign keyless · Sigstore]:::security
        end

        subgraph AssistantTrack["Assistant track  (parallel)"]
            BuildAssistant[🐳 build-assistant\nDockerfile · amd64+arm64]:::build
            GHCRAssistant[📦 push → GHCR\n*-assistant]:::registry
            SbomAssistant[📋 sbom-assistant\nSyft + GitHub Attestation]:::sbom
            ScanAssistant[🔒 scan-assistant\nTrivy CRITICAL+HIGH + SARIF]:::security
            SignAssistant[✍️ sign-assistant\ncosign keyless · Sigstore]:::security
        end

        subgraph SyncJob["sync  (needs: both sign jobs)"]
            ValuesUpdate[📝 Update image tags\nvalues.prod.yaml]:::gitops
            GitCommit[💾 git commit + push\nskip ci]:::gitops
        end

    end

    Push --> EcommerceCIWorkflow
    Push --> AssistantCIWorkflow
    Push --> BuildEcommerce
    Push --> BuildAssistant

    BuildEcommerce --> GHCREcommerce
    GHCREcommerce  --> SbomEcommerce
    GHCREcommerce  --> ScanEcommerce
    ScanEcommerce  --> SignEcommerce
    BuildEcommerce --> SignEcommerce

    BuildAssistant --> GHCRAssistant
    GHCRAssistant  --> SbomAssistant
    GHCRAssistant  --> ScanAssistant
    ScanAssistant  --> SignAssistant
    BuildAssistant --> SignAssistant

    SignEcommerce --> SyncJob
    SignAssistant --> SyncJob

    ValuesUpdate --> GitCommit
