graph TD
    %% CI/CD deployment pipeline - GitHub Actions
    %% deploy.yml: build → [sbom ∥ scan] → sign → sync
    %% ci.yml runs independently (same push trigger, not a gate)

    classDef trigger  fill:#000,    color:#fff, stroke:#000, stroke-width:2px;
    classDef ci       fill:#1a7f5a, color:#fff, stroke:#000, stroke-width:2px;
    classDef build    fill:#0637c0, color:#fff, stroke:#000, stroke-width:2px;
    classDef security fill:#c0392b, color:#fff, stroke:#000, stroke-width:2px;
    classDef sbom     fill:#8e44ad, color:#fff, stroke:#000, stroke-width:2px;
    classDef registry fill:#8e44ad, color:#fff, stroke:#000, stroke-width:2px;
    classDef gitops   fill:#e67e22, color:#fff, stroke:#000, stroke-width:2px;

    Push[🚀 git push → main]:::trigger

    subgraph CIWorkflow["ci.yml  (independent)"]
        Lint[🔍 PHP-CS-Fixer\nESLint + Stylelint]:::ci
        PHPUnit[🧪 PHPUnit\nUnit + Integration]:::ci
        Vitest[🧪 Vitest\nUnit + Integration]:::ci
        Playwright[🎭 Playwright\nEnd-to-end]:::ci
    end

    subgraph DeployWorkflow["deploy.yml"]
        subgraph BuildJob["build"]
            DockerBuild[🐳 docker build\nDockerfile.prod\nlinux/amd64 + arm64]:::build
            GHCR[📦 push → GHCR]:::registry
        end

        subgraph SbomJob["sbom  (parallel)"]
            SBOM[📋 Syft SBOM\nspdx-json]:::sbom
            Attest[🔗 GitHub Attestation\nSBOM + digest]:::sbom
        end

        subgraph ScanJob["scan  (parallel)"]
            Trivy[🔒 Trivy\nCRITICAL + HIGH]:::security
            SARIF[📊 Upload SARIF\n→ Security tab]:::security
        end

        subgraph SignJob["sign  (needs: build + scan)"]
            Cosign[✍️ cosign keyless\nSigstore OIDC]:::security
        end

        subgraph SyncJob["sync  (needs: build + scan + sign)"]
            ValuesUpdate[📝 Update image tag\nvalues.prod.yaml]:::gitops
            GitCommit[💾 git commit + push\nskip ci]:::gitops
        end
    end

    Push --> CIWorkflow
    Push --> BuildJob

    DockerBuild --> GHCR

    GHCR --> SbomJob
    GHCR --> ScanJob

    SBOM --> Attest

    ScanJob  --> SignJob
    BuildJob --> SignJob

    Trivy --> SARIF

    SignJob --> SyncJob
    ValuesUpdate --> GitCommit
