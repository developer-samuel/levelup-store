graph TD
    %% Subgraph styles
    style Runtime fill:#eceff1, stroke:#000, stroke-width:2px;
    style DataStores fill:#eceff1, stroke:#000, stroke-width:2px;
    style Messaging fill:#eceff1, stroke:#000, stroke-width:2px;
    style Storage fill:#eceff1, stroke:#000, stroke-width:2px;
    style Realtime fill:#eceff1, stroke:#000, stroke-width:2px;
    style ExternalServices fill:#eceff1, stroke:#000, stroke-width:2px;
    style Observability fill:#eceff1, stroke:#000, stroke-width:2px;

    %% Class Styles
    classDef app fill:#000, color:#fff;
    classDef runtime fill:#696969, color:#fff, stroke:#000, stroke-width:2px;
    classDef database fill:#0637c0, color:#fff, stroke:#000, stroke-width:2px;
    classDef cache fill:#e67e22, color:#fff, stroke:#000, stroke-width:2px;
    classDef messaging fill:#c0392b, color:#fff, stroke:#000, stroke-width:2px;
    classDef storage fill:#16a085, color:#fff, stroke:#000, stroke-width:2px;
    classDef realtime fill:#8e44ad, color:#fff, stroke:#000, stroke-width:2px;
    classDef client fill:#2c3e50, color:#fff, stroke:#000, stroke-width:2px;
    classDef external fill:#e7d62f, color:#000, stroke:#000, stroke-width:2px;
    classDef monitoring fill:#27ae60, color:#fff, stroke:#000, stroke-width:2px;

    %% Root
    App[⚙️ Application]:::app

    %% Runtime / Entrypoints
    subgraph Runtime["Runtime"]
        Nginx[🌐 Nginx]:::runtime
        Worker[⚙️ Messenger Worker]:::runtime
        Cron[⏱️ Cron Scheduler]:::runtime
    end

    %% Data Stores
    subgraph DataStores["Data"]
        DB[🟦 PostgreSQL]:::database
        Search[🔍 Elasticsearch]:::database
        Cache[🟧 Redis]:::cache
    end

    %% Message Broker
    subgraph Messaging["Messaging"]
        Queue[🐇 RabbitMQ]:::messaging
    end

    %% Object Storage
    subgraph Storage["Storage"]
        MinIO[🗄️ MinIO]:::storage
    end

    %% Real-time
    subgraph Realtime["Real-time"]
        Mercure[📡 Mercure]:::realtime
        Browser[🌐 Browser Client]:::client
    end

    %% External Services
    subgraph ExternalServices["External Services"]
        Stripe[💳 Stripe]:::external
        SMTP[✉️ SMTP]:::external
        CountryAPI[🌍 Country API]:::external
        Sentry[🔴 Sentry]:::external
    end

    %% Observability
    subgraph Observability["Observability"]
        Prometheus[📊 Prometheus]:::monitoring
        Loki[📋 Loki]:::monitoring
        Alloy[🔄 Alloy]:::monitoring
        AlertManager[🔔 AlertManager]:::monitoring
        Grafana[📈 Grafana]:::monitoring
    end

    %% HTTP request flow
    Browser --> Nginx
    Nginx --> App

    %% App → Data
    App --> DB
    App --> Search
    App --> Cache
    App --> MinIO

    %% App → Messaging
    App --> Queue

    %% Worker: consumes queue, indexes into Elasticsearch
    Queue --> Worker
    Worker --> Search

    %% Real-time: App publishes, browser subscribes
    App --> Mercure
    Mercure --> Browser

    %% Scheduled tasks
    Cron --> App

    %% External APIs
    App --> Stripe
    App --> SMTP
    App --> CountryAPI
    App --> Sentry

    %% Observability pipeline
    App --> Prometheus
    Alloy --> Loki
    Prometheus --> AlertManager
    Prometheus --> Grafana
    Loki --> Grafana
