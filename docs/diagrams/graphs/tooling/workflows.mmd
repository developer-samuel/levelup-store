graph TD
    %% Class Styles
    classDef root fill:#000, color:#fff;
    classDef deploy fill:#0637c0, color:#fff, stroke:#000, stroke-width:2px;
    classDef security fill:#c0392b, color:#fff, stroke:#000, stroke-width:2px;
    classDef validation fill:#e67e22, color:#fff, stroke:#000, stroke-width:2px;
    classDef release fill:#b45309, color:#fff, stroke:#000, stroke-width:2px;

    %% Root
    GHA[🚀 GitHub Actions]:::root

    %% ── Deploy ────────────────────────────────────────────────────────────────

    subgraph Deploy["Deploy"]
        DeployYml[🐳 deploy.yml - build image, SBOM, Trivy, sign, sync ArgoCD]:::deploy
        NotifyYml[🔔 notify.yml - deployment notification]:::deploy
    end

    %% ── Security ──────────────────────────────────────────────────────────────

    subgraph Security["Security"]
        CveScan[🔒 cve-scan.yml - Trivy CVE scan]:::security
        SupplyChain[🔗 supply-chain.yml - Gitleaks, OSSF Scorecard]:::security
    end

    %% ── Validation ────────────────────────────────────────────────────────────

    subgraph Validation["Validation"]
        InfraValidate[🏗️ infrastructure-validate.yml]:::validation
        InfraLint[🔧 infrastructure-lint.yml]:::validation
        RenovateValidate[🔄 renovate-validate.yml]:::validation
        ValidateCommits[✅ validate-commits.yml]:::validation
        Labeler[🏷️ labeler.yml]:::validation
    end

    %% ── Release ───────────────────────────────────────────────────────────────

    subgraph Release["Release"]
        ReleaseDrafter[📝 release-drafter.yml - update release draft]:::release
        ReleaseYml[📦 release.yml - prepend CHANGELOG, commit]:::release
    end

    %% Connections
    GHA --> Deploy
    GHA --> Security
    GHA --> Validation
    GHA --> Release

    %% Deploy flow
    DeployYml --> NotifyYml
