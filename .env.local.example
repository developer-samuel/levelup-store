##########################################################################
#                                                                        #
#               🛠️ LOCAL OVERRIDES (without Docker) 🛠️                  #
#                                                                        #
##########################################################################

# Copy to .env.local - for XAMPP / native PHP (no Docker needed).
# For Docker: use .env instead.

# ╭────────────────────────╮
#  ⚙️ Application Settings
# ╰────────────────────────╯
APP_ENV=dev
APP_DEBUG=1
APP_DOMAIN=127.0.0.1:8000
APP_URL=http://${APP_DOMAIN}

# ╭───────────────────╮
#  🛡️ Security & CORS
# ╰───────────────────╯
APP_SECRET=
HMAC_SECRET=
CORS_ALLOW_ORIGIN='.*'

# ╭──────────────────────────────────╮
#  🛡️ Cloudflare Turnstile (CAPTCHA)
# ╰──────────────────────────────────╯
TURNSTILE_ENABLED=false

# ╭───────────────────╮
#  🗄️ Database Config
# ╰───────────────────╯

### 👉 MySQL (default for XAMPP)
SERVER_VERSION=8.0.42-MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=levelup_store
DB_USERNAME=root
DB_PASSWORD=
DATABASE_URL=mysql://$DB_USERNAME:$DB_PASSWORD@$DB_HOST:$DB_PORT/$DB_DATABASE?serverVersion=$SERVER_VERSION

### 👉 PostgreSQL (uncomment to use instead)
#SERVER_VERSION=17
#DB_HOST=127.0.0.1
#DB_PORT=5432
#DB_DATABASE=levelup_store
#DB_USERNAME=postgres
#DB_PASSWORD=secret
#DATABASE_URL=pgsql://$DB_USERNAME:$DB_PASSWORD@$DB_HOST:$DB_PORT/$DB_DATABASE?serverVersion=${SERVER_VERSION}&charset=utf8&search_path=public

# ╭───────────────────────────────╮
#  🔍 Elasticsearch Configuration
# ╰───────────────────────────────╯
ELASTICSEARCH_ENABLED=false

# ╭───────────────────────╮
#  🧰 Redis Configuration
# ╰───────────────────────╯
REDIS_ENABLED=false

# ╭───────────────────────╮
#  🗄️ MinIO Configuration
# ╰───────────────────────╯
MINIO_ENABLED=false

# ╭───────────────────────╮
#  📋 Audit Configuration
# ╰───────────────────────╯
AUDIT_LOGS_ENABLED=true

# ╭───────────────────────────────╮
#  🐇 RabbitMQ Settings
# ╰───────────────────────────────╯
RABBITMQ_ENABLED=false

# ╭───────────────────────────────╮
#  🚀 Messenger / Queue Transport
# ╰───────────────────────────────╯
#
# RABBITMQ_ENABLED=false → doctrine (DB-based queue, no RabbitMQ needed)
#
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# ╭────────────────────────────────────╮
#  📡 Mercure Real-time Configuration
# ╰────────────────────────────────────╯
MERCURE_ENABLED=false
MERCURE_JWT_SECRET=

# ╭─────────────────╮
#  📩 Mail Settings
# ╰─────────────────╯
#
# ⚠️ MAILER_PASS must be URL-encoded if it contains special characters.
# '@' -> %40, ':' -> %3A, '/' -> %2F
#
# Mailpit - local email testing: docker run -p 1025:1025 -p 8025:8025 axllent/mailpit
#MAILER_DSN=smtp://localhost:1025

MAILER_SCHEME=smtps
MAILER_USER=
MAILER_PASS=
MAILER_HOST=
MAILER_PORT=
MAILER_DSN=${MAILER_SCHEME}://${MAILER_USER}:${MAILER_PASS}@${MAILER_HOST}:${MAILER_PORT}

# ╭────────────────────╮
#  💳 Payment Gateways
# ╰────────────────────╯
STRIPE_SECRET=<your-stripe-secret>

# ╭──────────────────────╮
#  🔑 JWT Authentication
# ╰──────────────────────╯
JWT_PASSPHRASE=

# ╭──────────────╮
#  🖨️ PDF Generation
# ╰──────────────╯
WKHTMLTOPDF_ENABLED=false
