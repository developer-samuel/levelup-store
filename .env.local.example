##########################################################################
#                                                                        #
#                         🛠️ ACTIVE SETTINGS 🛠️                         #
#                                                                        #
##########################################################################

# ╭────────────────────────╮
#  ⚙️ Application Settings
# ╰────────────────────────╯
APP_ENV=dev
APP_DEBUG=1
APP_URL=http://127.0.0.1:8000

# ╭───────────────────╮
#  🛡️ Security & CORS
# ╰───────────────────╯

# 🔑 Application secret used for framework encryption / CSRF
APP_SECRET=

# 🧩 Dedicated secret for HMAC signing (hidden inputs, tokens, etc.)
HMAC_SECRET=

# 🌐 Trusted proxy IPs - ensures correct client IP resolution behind reverse proxies / load balancers
TRUSTED_PROXIES=127.0.0.1,172.18.0.1,REMOTE_ADDR

# 🔒 Allowed CORS origins - regex pattern matched against the request Origin header
CORS_ALLOW_ORIGIN='.*'

# ╭───────────────────╮
#  🗄️ Database Config
# ╰───────────────────╯

### 👉 MySQL (default)
SERVER_VERSION=8.0.42-MySQL

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=levelup_store
DB_USERNAME=root
DB_PASSWORD=
DATABASE_URL=mysql://$DB_USERNAME:$DB_PASSWORD@$DB_HOST:$DB_PORT/$DB_DATABASE?serverVersion=$SERVER_VERSION

### 👉 PostgreSQL (uncomment to use instead)
#SERVER_VERSION=17

#DB_HOST=127.0.0.1
#DB_PORT=5432
#DB_DATABASE=levelup_store
#DB_USERNAME=postgres
#DB_PASSWORD=secret
#DATABASE_URL=pgsql://$DB_USERNAME:$DB_PASSWORD@$DB_HOST:$DB_PORT/$DB_DATABASE?serverVersion=${SERVER_VERSION}&charset=utf8&search_path=public

# ╭───────────────────────────────╮
#  🔍 Elasticsearch Configuration
# ╰───────────────────────────────╯
ELASTICSEARCH_ENABLED=false
#ELASTICSEARCH_HOST=elasticsearch
#ELASTICSEARCH_PORT=9200

# ╭───────────────────────╮
#  🧰 Redis Configuration
# ╰───────────────────────╯
REDIS_ENABLED=false
#REDIS_HOST=redis
#REDIS_PORT=6379
#REDIS_URL=redis://$REDIS_HOST:$REDIS_PORT

# ╭───────────────────────╮
#  📋 Audit Configuration
# ╰───────────────────────╯
AUDIT_LOGS_ENABLED=true

# ╭────────────────────────────╮
#  📊 Monitoring Configuration
# ╰────────────────────────────╯
# Sentry
#SENTRY_DSN=

# Prometheus
#PROMETHEUS_PORT=9090

# Grafana
#GRAFANA_PORT=3000
#GRAFANA_ADMIN_USER=admin
#GRAFANA_ADMIN_PASSWORD=admin

# pgAdmin
#PGADMIN_EMAIL=admin@admin.com
#PGADMIN_PASSWORD=admin

# ╭───────────────────────────────╮
#  🐇 RabbitMQ Settings
# ╰───────────────────────────────╯
RABBITMQ_ENABLED=false
#RABBITMQ_HOST=rabbitmq
#RABBITMQ_PORT=5672
#RABBITMQ_USER=guest
#RABBITMQ_PASS=guest
#RABBITMQ_VHOST=/

# ╭───────────────────────────────╮
#  🚀 Messenger / Queue Transport
# ╰───────────────────────────────╯
#
# ⚠️ RABBITMQ_ENABLED controls which transport is used:
# RABBITMQ_ENABLED=true  → set MESSENGER_TRANSPORT_DSN to amqp://
# RABBITMQ_ENABLED=false → set MESSENGER_TRANSPORT_DSN to doctrine://
#
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
#MESSENGER_TRANSPORT_DSN=amqp://${RABBITMQ_USER}:${RABBITMQ_PASS}@${RABBITMQ_HOST}:${RABBITMQ_PORT}/${RABBITMQ_VHOST}

# ╭─────────────────╮
#  📩 Mail Settings
# ╰─────────────────╯

# ⚠️ IMPORTANT:
# MAILER_PASS MUST be URL-encoded if it contains special characters.
# Otherwise MAILER_DSN parsing WILL BREAK.
#
# Examples:
# '@'  -> %40
# ':'  -> %3A
# '/'  -> %2F

### 👉 SMTP - production or external provider
MAILER_SCHEME=smtps
MAILER_USER=
MAILER_PASS=
MAILER_HOST=
MAILER_PORT=
MAILER_DSN=${MAILER_SCHEME}://${MAILER_USER}:${MAILER_PASS}@${MAILER_HOST}:${MAILER_PORT}

### 👉 Mailpit - local email testing (uncomment if running Mailpit locally)
#MAILER_DSN=smtp://localhost:1025

# ╭────────────────────╮
#  💳 Payment Gateways
# ╰────────────────────╯
STRIPE_SECRET=

# ╭──────────────────────╮
#  🔑 JWT Authentication
# ╰──────────────────────╯
JWT_PASSPHRASE=

# 15 minutes
JWT_TTL=900

# 30 days
JWT_REFRESH_TTL=2592000

# ╭─────────────────────╮
#  🌍 External API URLs
# ╰─────────────────────╯
API_COUNTRY_URL=https://www.apicountries.com/countries

# ╭──────────────────╮
#  🖨️ PDF Generation
# ╰──────────────────╯
WKHTMLTOPDF_ENABLED=false

### 👉 Linux/macOS / Docker (default)
#WKHTMLTOPDF_PATH="/usr/local/bin/wkhtmltopdf"

### 👉 Windows with XAMPP
#WKHTMLTOPDF_PATH="C:\Program Files\wkhtmltopdf\bin\wkhtmltopdf.exe"
