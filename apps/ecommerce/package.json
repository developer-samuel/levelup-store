{
  "name": "ecommerce",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "type-check": "tsc --noEmit",
    "type-check:test": "tsc --noEmit --project tsconfig.test.json",
    "type-check:all": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json",
    "lint": "eslint assets/ts/**/*.ts",
    "lint:fix": "eslint assets/ts/**/*.ts --fix",
    "lint:all": "eslint assets/ts/**/*.ts tests/vitest/**/*.ts",
    "lint:all:fix": "eslint assets/ts/**/*.ts tests/vitest/**/*.ts --fix",
    "lint:report": "eslint assets/ts/**/*.ts tests/vitest/**/*.ts --format json --output-file var/tools/eslint/report.json || true",
    "lint-scss": "stylelint assets/scss/**/*.scss",
    "lint-scss:fix": "stylelint assets/scss/**/*.scss --fix",
    "prettier:fix": "prettier --write \"assets/ts/**/*.ts\"",
    "prettier:all:fix": "prettier --write \"assets/ts/**/*.ts\" \"tests/vitest/**/*.ts\"",
    "vitest": "vitest run --coverage",
    "vitest:watch": "vitest --watch",
    "vitest:ui": "vitest --ui --coverage",
    "e2e": "vite build && playwright test",
    "e2e:fast": "playwright test",
    "e2e:ui": "vite build && playwright test --ui",
    "e2e:debug": "playwright test --debug",
    "e2e:report": "playwright show-report var/tools/playwright/html"
  },
  "dependencies": {
    "apexcharts": "^5.3.4",
    "axios": "^1.20.0",
    "notyf": "^3.10.0",
    "sass": "^1.104.0",
    "swiper": "^12.0.3",
    "vanilla-datatables": "^1.6.16",
    "vite": "^8.3.5",
    "vite-plugin-symfony": "^8.2.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@mermaid-js/mermaid-cli": "11.17.0",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@types/node": "25.9.8",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "4.1.11",
    "dotenv": "17.4.2",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "61.7.1",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-tsdoc": "0.5.3",
    "globals": "17.12.0",
    "jsdom": "27.4.0",
    "postcss-scss": "4.0.9",
    "prettier": "3.9.9",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-scss": "7.3.0",
    "tinyexec": "1.3.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
