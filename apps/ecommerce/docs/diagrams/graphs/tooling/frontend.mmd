graph TD
    %% Subgraph styles
    style TypeChecking fill:#eceff1, stroke:#000, stroke-width:2px;
    style Linting fill:#eceff1, stroke:#000, stroke-width:2px;
    style Metrics fill:#eceff1, stroke:#000, stroke-width:2px;

    %% Class Styles
    classDef tools fill:#000, color:#fff;
    classDef typecheck fill:#8e44ad, color:#fff, stroke:#000, stroke-width:2px;
    classDef linting fill:#0f63ff, color:#fff, stroke:#000, stroke-width:2px;
    classDef metrics fill:#00a676, color:#fff, stroke:#000, stroke-width:2px;

    %% Root
    Frontend[⚡ Frontend - pnpm]:::tools

    %% Type Checking
    subgraph TypeChecking["🔍 Type Checking"]
        TypeCheck[TypeScript Type Check]
    end

    %% Linting & Formatting
    subgraph Linting["✨ Linting & Formatting"]
        ESLint[ESLint + Prettier]
        SCSSLint[Stylelint]
    end

    %% Metrics
    subgraph Metrics["📊 Metrics"]
        SLOC[SLOC - TS / SCSS]
    end

    %% Classes
    class TypeCheck typecheck;
    class ESLint,SCSSLint linting;
    class SLOC metrics;

    %% Connections
    Frontend --> TypeChecking
    Frontend --> Linting
    Frontend --> Metrics
