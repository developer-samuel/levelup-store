{% macro render(results) %}
    {% import 'components/reviews-rating/average-rating-stars.html.twig' as Stars %}

    {% for result in results %}
        <a href="/product/show/{{ result.url }}" class="search__list-item">
            <div class="search__list-image">
                <img
                    src="{{ storage_url(result.image) }}"
                    alt="{{ result.image ? 'Image: ' ~ result.image : 'Image not found' }}"
                >
            </div>
            <div class="search__list-name">
                <p>{{ result.name }}</p>
            </div>
            <div class="search-panel__list-rating product-item__box-rating">
                {{ Stars.render(result.averageRating) }}
            </div>
            <div class="search__list-price">
                <span class="search__list-price-current">
                    {% if result.hasDiscount %}
                        {{ result.price - result.discountPrice }} €
                    {% else %}
                        {{ result.price }} €
                    {% endif %}
                </span>
                {% if result.hasDiscount %}
                    <span class="search__list-price-old">
                        {{ result.price }} €
                    </span>
                {% endif %}
            </div>
        </a>
    {% endfor %}
{% endmacro %}
