{% macro render(token, errors = []) %}
    {% import 'base/form.html.twig' as Form %}

    {% set tokenValue = token.token %}

    {{
        Form.render(
            'reset-password-form',
            'auth-page__card-form',
            'reset_password_store',
            'features/auth/password/reset/forms/wrapper/reset-password-wrapper.html.twig',
            {'errors': errors},
            [
                { 'name': 'token', 'value': tokenValue },
            ]
        )
    }}
{% endmacro %}
