{% macro render(errors = []) %}
    {% import 'components/form/action.html.twig' as FormControlAction %}
    {% import 'components/form/switch.html.twig' as FormSwitch %}
    {% import 'features/auth/password/forgot/forms/sections/fields.html.twig' as ForgotPasswordSectionData %}

    {{ ForgotPasswordSectionData.render(errors ?? []) }}

    {{
        FormControlAction.render(
            'auth-page__card-form-action',
            'auth-page__card-form-action-btn',
            'Send Mail'
        )
    }}

    {{
        FormSwitch.render(
            'Do you want to',
            path('login'),
            'Log in?'
        )
    }}
{% endmacro %}
