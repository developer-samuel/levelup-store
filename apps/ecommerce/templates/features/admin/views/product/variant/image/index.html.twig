{% extends 'app/base.html.twig' %}

{% block title %}Admin - Variant Images{% endblock %}

{% block admin_body %}
    {% import 'features/admin/common/tables/table-content.html.twig' as TableContent %}

    {{
        TableContent.render(
            'admin-variant-images-page',
            'Images (' ~ variant.name ~ ')',
            'admin-variant-images-table',
            [
                'Image',
                'Created at'
            ],
            path('admin_variants_index', {'id': variant.id})
        )
    }}
{% endblock %}
