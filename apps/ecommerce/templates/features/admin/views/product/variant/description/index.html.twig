{% extends 'app/base.html.twig' %}

{% block title %}Admin - Variant Descriptions{% endblock %}

{% block admin_body %}
    {% import 'features/admin/common/tables/table-content.html.twig' as TableContent %}

    {{
        TableContent.render(
            'admin-variant-descriptions-page',
            'Descriptions (' ~ variant.name ~ ')',
            'admin-variant-descriptions-table',
            [
                'Title',
                'Body',
                'Created At',
                ''
            ],
            path('admin_variants_index', {'id': variant.id}),
            [
                {
                    'url': path('admin_variants_descriptions_create', { 'id': variant.id }),
                    'label': 'Create',
                    'color': 'green'
                }
            ]
        )
    }}
{% endblock %}
