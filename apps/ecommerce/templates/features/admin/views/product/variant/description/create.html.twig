{% extends 'app/base.html.twig' %}

{% block title %}Admin - Variant Description (Create){% endblock %}

{% block admin_body %}
    {% import 'features/admin/common/forms/form-content.html.twig' as FormContent %}

    {{
        FormContent.render(
            'admin-variant-descriptions-create-page',
            'Create Description (' ~ variant.name ~ ')',
            'features/admin/views/product/variant/description/forms/create.html.twig',
            path('admin_variants_descriptions_index', {'id': variant.id}),
            {
                'variant': variant,
                'errors': errors ?? []
            }
        )
    }}
{% endblock %}
