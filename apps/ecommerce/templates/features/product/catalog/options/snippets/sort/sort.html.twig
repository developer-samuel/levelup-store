{% macro render(sortOptions, sort) %}
    <div class="products__card-sort">
        <div class="products__card-sort-select-wrapper">
            <select id="sort-by" name="sort" class="products__card-sort-select-field">
                {% for option in sortOptions %}
                    <option
                        value="{{ option.value }}"
                        {{ sort == option.value ? 'selected' : '' }}
                        class="products__card-sort-select-option"
                    >
                        {{ option.label }}
                    </option>
                {% endfor %}
            </select>
        </div>
    </div>
{% endmacro %}
