{% macro render(banner) %}
    <div class="home-page__banners-item">
        <div class="home-page__discount">
            <a href="{{ path('discounts') }}" class="home-page__discount-item">
                <img
                    id="discount-banner"
                    src="{{ banner.image ? storage_url(banner.image) : asset('img/misc/image/no-image.webp') }}"
                    alt="Banner"
                    fetchpriority="high"
                >
            </a>
        </div>
    </div>
{% endmacro %}
