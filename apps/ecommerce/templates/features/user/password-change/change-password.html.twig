{% extends 'app/base.html.twig' %}

{% block title %}Change Password{% endblock %}

{% block body %}
    {% import 'components/common/title.html.twig' as Title %}
    {% import 'components/alert/alert.html.twig' as Alert %}
    {% import 'features/user/password-change/forms/change-password.html.twig' as ChangePasswordForm %}

    <main class="content">
        <div id="change-password-page" class="user">
            <div class="user__action">
                <a
                    href="{{ path('profile') }}"
                    class="user__action-link"
                >
                    Profile
                </a>
            </div>

            {{
                Title.render(
                    'Change Password',
                    'user__title',
                    'h1',
                )
            }}

            {{ Alert.render() }}

            {{ ChangePasswordForm.render(errors ?? []) }}
        </div>
    </main>
{% endblock %}
