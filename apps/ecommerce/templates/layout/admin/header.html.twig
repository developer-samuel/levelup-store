{% macro render() %}
    <header class="admin-header">
        <div class="admin-header__section">
            <a href="{{ path('admin') }}" class="admin-header__link">
                <img
                    src="{{ asset('img/icons/app/home.png') }}"
                    alt="Admin Menu"
                    class="admin-header__link-img"
                >
            </a>
            <div class="admin-header__logout">
                <div class="admin-header__logout-btn logout-btn">
                    <p>
                        Log Out
                    </p>
                </div>
            </div>
        </div>
    </header>
{% endmacro %}
