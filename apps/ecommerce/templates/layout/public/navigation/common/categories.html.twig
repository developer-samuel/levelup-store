{% macro render(categories, type) %}
    {% import 'layout/public/navigation/list/snippets/item.html.twig' as Item %}

    {% set prefix = type == 'mobile' ? 'mobile-' : '' %}
    {% set baseClass = type == 'mobile' ? 'navigation__mobile-item' : 'navigation__list-item' %}
    {% set imageClass = type == 'mobile' ? 'navigation__mobile-item-image' : 'navigation__list-item-image' %}
    {% set nameClass = type == 'mobile' ? 'navigation__mobile-item-name' : 'navigation__list-item-name' %}

    {% for category in categories %}
        {{
            Item.render(
                path('products_index', { 'category': category.name|lower|replace({' ': '-'}) }),
                prefix ~ category.name|lower|replace({' ': '-'}) ~ '-item',
                category.name,
                asset('img/icons/categories/' ~ category.name|lower ~ '.png'),
                baseClass,
                imageClass,
                nameClass,
                category.name
            )
        }}
    {% endfor %}

    {{
        Item.render(
            path('discounts'),
            prefix ~ 'discount-item',
            'Discounts',
            asset('img/icons/elements/discount.png'),
            baseClass,
            imageClass,
            nameClass,
            'Discounts'
        )
    }}
{% endmacro %}
