<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Verification</title>
</head>
<body>
    <h2>Verification Request</h2>
    <p>Hello {{ user.getFullName() }},</p>
    <p>Thank you for registering with LevelUp Store. To complete your registration and activate your account, please verify your email address by clicking the button below:</p>
    <p>
        <a href="{{ verificationUrl }}" class="button" target="_blank" rel="noopener noreferrer">
            Verify My Email
        </a>
    </p>
    <p>If you did not request this, please ignore this email.</p>
    <p>Thanks,<br>LevelUp Store</p>
</body>
</html>
