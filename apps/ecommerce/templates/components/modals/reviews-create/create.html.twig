{% macro render(variant) %}
    {% import 'components/common/title.html.twig' as Title %}
    {% import 'components/alert/alert.html.twig' as Alert %}
    {% import 'components/modals/reviews-create/forms/create-form.html.twig' as ReviewsForm %}

    <div id="reviews-modal" class="modal reviews-modal">
        <div class="reviews-modal__body">
            <div class="reviews-modal__body-close">
                <button id="review-modal-close" aria-label="Close">
                    <img src="{{ asset('img/icons/actions/close.png') }}" alt="Close">
                </button>
            </div>

            {{
                Title.render(
                    'Rate this product',
                    'reviews-modal__body-title',
                    'h2',
                )
            }}

            <div class="reviews-modal__content">
                {{ Alert.render() }}

                {{ ReviewsForm.render(variant, errors ?? []) }}
            </div>
        </div>
    </div>
{% endmacro %}
