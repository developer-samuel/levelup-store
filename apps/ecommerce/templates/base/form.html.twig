{% macro render(id = null, class, csrf_intention, layout = null, params = {}, hidden_inputs = []) %}
    <form id="{{ id }}" class="{{ class }}">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token(csrf_intention) }}">

        {% for input in hidden_inputs %}
            <input
                type="hidden"
                name="{{ input.name }}"
                value="{{ input.value }}"
                {% if input.id is defined %}id="{{ input.id }}"{% endif %}
                {% if input.attrs is defined %}{% for attrName, attrValue in input.attrs %} {{ attrName }}="{{ attrValue }}"{% endfor %}{% endif %}
            >
        {% endfor %}

        {% if layout is not null %}
            {% import layout as FormLayout %}
            {{ FormLayout.render(params) }}
        {% endif %}
    </form>
{% endmacro %}
