graph TD
    %% Class Styles
    classDef root fill:#000, color:#fff;
    classDef ci fill:#1a7f5a, color:#fff, stroke:#000, stroke-width:2px;
    classDef quality fill:#6b21a8, color:#fff, stroke:#000, stroke-width:2px;
    classDef security fill:#c0392b, color:#fff, stroke:#000, stroke-width:2px;
    classDef validation fill:#e67e22, color:#fff, stroke:#000, stroke-width:2px;

    %% Root
    GHA[🚀 GitHub Actions]:::root

    %% ── CI ────────────────────────────────────────────────────────────────────

    subgraph CI["CI"]
        CIYml[🚀 assistant-ci.yml - lint]:::ci
    end

    %% ── Quality ───────────────────────────────────────────────────────────────

    subgraph Quality["Quality"]
        FrontendAudit[🏠 assistant-frontend-audit.yml - Lighthouse, axe-core, pa11y]:::quality
        BundleSize[📦 assistant-bundle-size.yml - bundle size report]:::quality
    end

    %% ── Security ──────────────────────────────────────────────────────────────

    subgraph Security["Security"]
        Zap[🕷️ assistant-zap.yml - OWASP ZAP DAST]:::security
        Sast[🔬 assistant-sast.yml - CodeQL]:::security
    end

    %% ── Validation ────────────────────────────────────────────────────────────

    subgraph Validation["Validation"]
        DockerValidate[🐳 assistant-docker-validate.yml]:::validation
    end

    %% Connections
    GHA --> CI
    GHA --> Quality
    GHA --> Security
    GHA --> Validation
