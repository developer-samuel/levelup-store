# ╭────────────────────────╮
#  ⚙️ Application Settings
# ╰────────────────────────╯

# Ecommerce store URL - used to generate product links in chat responses
ECOMMERCE_URL=http://localhost:8000

# ╭───────────────────────────╮
#  🤖 Assistant Configuration
# ╰───────────────────────────╯

# Backend type: api (cloud LLM) | ollama (local model)
ASSISTANT_TYPE=api

# 🌐 Used when ASSISTANT_TYPE=api
ASSISTANT_API_KEY=
ASSISTANT_MODEL=gemini-3.5-flash-lite
ASSISTANT_FALLBACK_MODEL=gemini-3.1-flash-lite
ASSISTANT_PRIMARY_LIMIT=20
ASSISTANT_FALLBACK_LIMIT=30

# 🖥️ Used when ASSISTANT_TYPE=ollama (local model on your machine)
# Docker (Mac/Windows): http://host.docker.internal:11434 | Production: http://ollama:11434
ASSISTANT_OLLAMA_HOST=http://localhost:11434
ASSISTANT_OLLAMA_MODEL=mistral:7b-instruct
ASSISTANT_OLLAMA_LIMIT=50

# ╭────────────────────────╮
#  🔍 RAG (Product Search)
# ╰────────────────────────╯

# Embedding model - always requires Ollama regardless of ASSISTANT_TYPE
ASSISTANT_OLLAMA_EMBED_MODEL=nomic-embed-text

# Vector database
CHROMA_HOST=http://chromadb:8000

# ╭────────────╮
#  🛡️ Security
# ╰────────────╯

# Allowed CORS origins - regex pattern
# Allow all (dev):  .*
# Single domain:    ^https://yourdomain\.com$
# Multiple domains: ^https://(domain1\.com|domain2\.com)$
CORS_ORIGINS=.*

# 🔑 Access key sent by the frontend as X-Api-Key header (leave empty to disable)
# Generate: openssl rand -hex 32
ASSISTANT_ACCESS_KEY=

# ╭──────────────────────╮
#  💬 Chat Configuration
# ╰──────────────────────╯

# Support email shown to customers when no relevant products are found
SUPPORT_EMAIL=

# ╭──────────────╮
#  🗄️ PostgreSQL
# ╰──────────────╯

# Same credentials as the Ecommerce app - must match docker-compose postgres service
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=levelup_store
DB_USERNAME=postgres
DB_PASSWORD=secret
DATABASE_URL=postgresql://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_DATABASE}

# ╭─────────╮
#  🔴 Redis
# ╰─────────╯

# Same credentials as the Ecommerce app - must match docker-compose redis service
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<your-redis-password>
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}

# Conversation history TTL
CONVERSATION_TTL_GUEST=86400    # 1 day
CONVERSATION_TTL_USER=2592000   # 30 days

# ╭────────────╮
#  🐇 RabbitMQ
# ╰────────────╯

# Same credentials as the Ecommerce app - must match docker-compose rabbitmq service
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_VHOST=/
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASS}@${RABBITMQ_HOST}:${RABBITMQ_PORT}/${RABBITMQ_VHOST}

# ╭─────────╮
#  🪣 MinIO
# ╰─────────╯

# Used to generate product image URLs in chat responses
# When MINIO_ENABLED=false, images are served from ECOMMERCE_URL/public/uploads/
MINIO_ENABLED=true
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_BUCKET=levelup-store

# ╭─────────────────╮
#  📊 Observability
# ╰─────────────────╯

# Sentry error tracking
SENTRY_DSN=

# OpenTelemetry tracing
OTEL_SERVICE_NAME=levelup-store-assistant
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
