# Docker (Mac/Windows): http://host.docker.internal:11434 | Production: http://ollama:11434
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# Model for generating embeddings (RAG)
OLLAMA_EMBED_MODEL=nomic-embed-text

# Allowed CORS origins - regex pattern
# Allow all (dev):  .*
# Single domain:    ^https://yourdomain\.com$
# Multiple domains: ^https://(domain1\.com|domain2\.com)$
CORS_ORIGINS=.*

CHROMA_HOST=http://chromadb:8000

# Same credentials as the Ecommerce app - must match docker-compose postgres service
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=levelup_store
DB_USERNAME=postgres
DB_PASSWORD=secret
DATABASE_URL=postgresql://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_DATABASE}

# Same credentials as the Ecommerce app - must match docker-compose redis service
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<your-redis-password>
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}

# Same credentials as the Ecommerce app - must match docker-compose rabbitmq service
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_VHOST=/
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASS}@${RABBITMQ_HOST}:${RABBITMQ_PORT}/${RABBITMQ_VHOST}

# Sentry
SENTRY_DSN=

# OpenTelemetry tracing
OTEL_SERVICE_NAME=levelup-store-assistant
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# API key for protecting the chat endpoint (leave empty to disable)
# Generate: openssl rand -hex 32
API_KEY=

# Support email shown to customers when no relevant products are found
SUPPORT_EMAIL=
