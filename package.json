{
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "watch": "vite",
    "type-check": "tsc --noEmit",
    "type-check:test": "tsc --noEmit --project tsconfig.test.json",
    "type-check:all": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json",
    "lint": "eslint assets/ts/**/*.ts",
    "lint:fix": "eslint assets/ts/**/*.ts --fix",
    "lint:all": "eslint assets/ts/**/*.ts assets/tests/**/*.ts",
    "lint:all:fix": "eslint assets/ts/**/*.ts assets/tests/**/*.ts --fix",
    "lint:report": "eslint assets/ts/**/*.ts assets/tests/**/*.ts --format json --output-file var/tools/eslint/report.json || true",
    "lint-scss": "stylelint assets/scss/**/*.scss",
    "lint-scss:fix": "stylelint assets/scss/**/*.scss --fix",
    "prettier:fix": "prettier --write \"assets/ts/**/*.ts\"",
    "prettier:all:fix": "prettier --write \"assets/ts/**/*.ts\" \"assets/tests/**/*.ts\"",
    "vitest": "vitest run --coverage",
    "vitest:watch": "vitest --watch",
    "vitest:ui": "vitest --ui --coverage",
    "e2e": "pnpm build && playwright test",
    "e2e:fast": "playwright test",
    "e2e:ui": "pnpm build && playwright test --ui",
    "e2e:debug": "playwright test --debug",
    "e2e:report": "playwright show-report var/tools/playwright/html"
  },
  "dependencies": {
    "apexcharts": "^5.3.4",
    "axios": "^1.9.0",
    "notyf": "^3.10.0",
    "sass": "^1.97.2",
    "swiper": "^12.0.3",
    "vanilla-datatables": "^1.6.16",
    "vite": "^7.3.0",
    "vite-plugin-symfony": "^8.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "^4.1.9",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-jsdoc": "^61.5.0",
    "eslint-plugin-prettier": "^5.5.0",
    "eslint-plugin-tsdoc": "^0.5.2",
    "globals": "^17.0.0",
    "jsdom": "^27.4.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.7.4",
    "sloc": "^0.3.2",
    "stylelint": "^17.4.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-scss": "^7.0.0",
    "tinyexec": "^1.2.4",
    "typescript": "^5.2.2",
    "vitest": "^4.1.9"
  },
  "allowScripts": {
    "file:.pnpm/esbuild@0.28.2/node_modules/esbuild": true,
    "file:../../esbuild@0.27.4/node_modules/esbuild": true,
    "file:../../../@parcel+watcher@2.5.6/node_modules/@parcel/watcher": true
  }
}
