#!/bin/bash
set -e

CHANGED=$(git diff --name-only "origin/$(git rev-parse --abbrev-ref HEAD)...HEAD" 2>/dev/null || git diff --name-only "$(git merge-base HEAD main)...HEAD")

run_ts=false
run_ecommerce_php=false
run_ecommerce_scss=false
run_assistant=false
run_workflows=false

if echo "$CHANGED" | grep -qE "^apps/ecommerce/src/|^apps/ecommerce/presets/|^apps/ecommerce/database/|^apps/ecommerce/tests/php-unit/|^apps/ecommerce/composer\.lock$"; then
  run_ecommerce_php=true
fi

if echo "$CHANGED" | grep -qE "^apps/ecommerce/.*\.(scss)$"; then
  run_ecommerce_scss=true
fi

if echo "$CHANGED" | grep -qE "\.(ts|tsx)$|^pnpm-lock\.yaml$|^pnpm-workspace\.yaml$"; then
  run_ts=true
fi

if echo "$CHANGED" | grep -qE "^apps/assistant/app/|^apps/assistant/jobs/|^apps/assistant/tests/|^apps/assistant/pyproject\.toml$|^apps/assistant/uv\.lock$"; then
  run_assistant=true
fi

if echo "$CHANGED" | grep -qE "^\.github/workflows/"; then
  run_workflows=true
fi

if $run_ecommerce_php; then
  echo "🔍 [ecommerce] Running PHPStan..."
  (cd apps/ecommerce && bin/run php vendor/bin/phpstan analyse --memory-limit=1G)

  echo "🔍 [ecommerce] Running PHP MD..."
  (cd apps/ecommerce && bin/run php vendor/bin/phpmd src presets/server xml phpmd.xml)

  echo "🔍 [ecommerce] Running Deptrac..."
  (cd apps/ecommerce && bin/run php scripts/tools/deptrac/launcher.php)

  echo "🔧 [ecommerce] Running PHP CS Fixer..."
  (cd apps/ecommerce && bin/run php vendor/bin/php-cs-fixer fix --quiet)

  if [ "${RUN_RECTOR:-0}" = "1" ]; then
    echo "🔧 [ecommerce] Running Rector..."
    (cd apps/ecommerce && bin/run php vendor/bin/rector process --quiet)
  fi
fi

if $run_ts; then
  echo "🔍 [all] Running TypeScript type-check (includes tests)..."
  pnpm type-check:all

  echo "🔍 [all] Running ESLint (includes tests)..."
  pnpm lint:all
fi

if $run_ecommerce_scss; then
  echo "🔍 [ecommerce] Running Stylelint..."
  pnpm --filter ecommerce lint-scss
fi

if $run_ts || $run_ecommerce_scss; then
  PRETTIER_FILES=$(echo "$CHANGED" | grep -E "\.(ts|tsx|scss|css)$" | while read -r f; do [ -f "$f" ] && echo "$f"; done | tr '\n' ' ')
  if [ -n "$PRETTIER_FILES" ]; then
    echo "🔧 [all] Running Prettier..."
    pnpm exec prettier --write --ignore-unknown --log-level warn $PRETTIER_FILES
  fi
fi

if $run_assistant; then
  echo "🔧 [assistant] Running ruff format..."
  (cd apps/assistant && uv run ruff format --cache-dir .cache/ruff app/ jobs/ tests/)

  echo "🔍 [assistant] Running ruff lint..."
  (cd apps/assistant && uv run ruff check --cache-dir .cache/ruff app/ jobs/ tests/)

  echo "🔍 [assistant] Running mypy..."
  (cd apps/assistant && uv run mypy --explicit-package-bases --cache-dir .cache/mypy app/ jobs/ tests/)

  echo "🔍 [assistant] Running vulture (dead code)..."
  (cd apps/assistant && uv run vulture app/ jobs/)
fi

AUTOFIX_CHANGED=$(git diff --name-only)
if [ -n "$AUTOFIX_CHANGED" ]; then
  echo "⚠️  Formatter made changes - staging them. Amend your last commit or commit separately, then push again."
  git add -u
  exit 1
fi

if $run_workflows; then
  echo "🔍 [ci] Running yamllint on GitHub Actions workflows..."
  yamllint .github/workflows/
fi

if command -v gitleaks &>/dev/null; then
  echo "🔑 Running Gitleaks secret scan..."
  gitleaks detect --no-banner
fi

INFRA_HOOK="$(git rev-parse --show-toplevel)/.githooks/pre-push-infra"
if [ -f "$INFRA_HOOK" ]; then
  bash "$INFRA_HOOK"
fi

echo "✅ Pre-push checks passed."
