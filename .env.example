# ⚠️ IMPORTANT: If any secret/password contains special characters, it MUST be URL-encoded.
# Examples: '@' -> %40  |  ':' -> %3A  |  '/' -> %2F
# To encode: open browser console → encodeURIComponent('your_password')

# ╭────────────────────────╮
#  ⚙️ Application Settings
# ╰────────────────────────╯
APP_ENV=dev
APP_DEBUG=1
APP_DOMAIN=127.0.0.1:8000
APP_URL=http://${APP_DOMAIN}

# ╭───────────────────╮
#  🛡️ Security & CORS
# ╰───────────────────╯

# 🔑 Application secret used for framework encryption / CSRF
APP_SECRET=

# 🧩 Dedicated secret for HMAC signing (hidden inputs, tokens, etc.)
HMAC_SECRET=

# 🌐 Trusted proxy IPs - ensures correct client IP resolution behind reverse proxies / load balancers
TRUSTED_PROXIES=127.0.0.1,172.18.0.1,REMOTE_ADDR

# 🔒 Allowed CORS origins - regex pattern matched against the request Origin header
# Production example: '^https://yourdomain\.com$'
CORS_ALLOW_ORIGIN='.*'

# ╭──────────────────────────────────╮
#  🛡️ Cloudflare Turnstile (CAPTCHA)
# ╰──────────────────────────────────╯
TURNSTILE_ENABLED=true
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
TURNSTILE_SECRET_KEY=<your-key-secret>
TURNSTILE_SITE_KEY=<your-key-site>

# ╭───────────────────╮
#  🗄️ Database Config
# ╰───────────────────╯

### 👉 PostgreSQL
SERVER_VERSION=17

DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=levelup_store
DB_USERNAME=postgres
DB_PASSWORD=secret
DATABASE_URL=pgsql://$DB_USERNAME:$DB_PASSWORD@$DB_HOST:$DB_PORT/$DB_DATABASE?serverVersion=${SERVER_VERSION}&charset=utf8&search_path=public

# ╭───────────────────────────────╮
#  🔍 Elasticsearch Configuration
# ╰───────────────────────────────╯
ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200

# ╭───────────────────────╮
#  🧰 Redis Configuration
# ╰───────────────────────╯
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}

# ╭───────────────────────╮
#  🗄️ MinIO Configuration
# ╰───────────────────────╯
MINIO_ENABLED=true
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_BUCKET=levelup-store

# ╭───────────────────────────╮
#  🔍 SonarQube Configuration
# ╰───────────────────────────╯
#
# Default login: admin / admin
# Token: My Account → Security → Generate Token
#
SONAR_HOST=http://localhost:9100
SONAR_HOST_INTERNAL=http://sonarqube:9000
SONAR_PROJECT_KEY=levelup-store
SONAR_TOKEN=<your-sonar-secret>

# ╭───────────────────────╮
#  📋 Audit Configuration
# ╰───────────────────────╯
AUDIT_LOGS_ENABLED=true

# ╭────────────────────────────╮
#  📊 Monitoring Configuration
# ╰────────────────────────────╯
# Sentry
SENTRY_DSN=null

# Prometheus
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_PORT=3030
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# pgAdmin
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin

# ╭───────────────────────────────╮
#  🐇 RabbitMQ Settings
# ╰───────────────────────────────╯
RABBITMQ_ENABLED=true
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_VHOST=/

# Generate: openssl rand -hex 32
RABBITMQ_ERLANG_COOKIE=

# ╭───────────────────────────────╮
#  🚀 Messenger / Queue Transport
# ╰───────────────────────────────╯
#
# ⚠️ RABBITMQ_ENABLED controls which transport is used:
# RABBITMQ_ENABLED=true  → set MESSENGER_TRANSPORT_DSN to amqp://
# RABBITMQ_ENABLED=false → set MESSENGER_TRANSPORT_DSN to doctrine://
#
MESSENGER_TRANSPORT_DSN=amqp://${RABBITMQ_USER}:${RABBITMQ_PASS}@${RABBITMQ_HOST}:${RABBITMQ_PORT}/${RABBITMQ_VHOST}

# ╭────────────────────────────────────╮
#  📡 Mercure Real-time Configuration
# ╰────────────────────────────────────╯
MERCURE_ENABLED=true
MERCURE_URL=http://mercure/.well-known/mercure
MERCURE_PUBLIC_URL=http://localhost:9300/.well-known/mercure
MERCURE_CORS_ORIGINS=https://yourdomain.com
MERCURE_JWT_SECRET=

# ╭─────────────────╮
#  📩 Mail Settings
# ╰─────────────────╯

### 👉 SMTP - production or external provider
MAILER_SCHEME=smtps
MAILER_USER=
MAILER_PASS=
MAILER_HOST=
MAILER_PORT=
MAILER_DSN=${MAILER_SCHEME}://${MAILER_USER}:${MAILER_PASS}@${MAILER_HOST}:${MAILER_PORT}

### 👉 Mailpit - local email testing (uncomment if running Mailpit locally)
#MAILER_DSN=smtp://mailpit:1025

# ╭────────────────────╮
#  💳 Payment Gateways
# ╰────────────────────╯
STRIPE_SECRET=<your-stripe-secret>

# ╭──────────────────────╮
#  🔑 JWT Authentication
# ╰──────────────────────╯
JWT_PASSPHRASE=

# 15 minutes
JWT_TTL=900

# 30 days
JWT_REFRESH_TTL=2592000

# ╭─────────────────────╮
#  🌍 External API URLs
# ╰─────────────────────╯
API_COUNTRY_URL=https://www.apicountries.com/countries

# ╭──────────────────╮
#  🖨️ PDF Generation
# ╰──────────────────╯
WKHTMLTOPDF_ENABLED=true
WKHTMLTOPDF_PATH="/usr/local/bin/wkhtmltopdf"


##########################################################################
#                                                                        #
#                         🏗️ DEPLOY SETTINGS 🏗️                         #
#                                                                        #
##########################################################################

# ╭───────────────────────╮
#  🌐 Domain + Repository
# ╰───────────────────────╯
GITHUB_USERNAME=<your-github-username>
GITHUB_REPO=levelup-store
GITHUB_REPO_URL=https://github.com/${GITHUB_USERNAME}/${GITHUB_REPO}.git
GHCR_IMAGE=ghcr.io/${GITHUB_USERNAME}/${GITHUB_REPO}

# ╭──────────────────────────────╮
#  🚀 ArgoCD
# ╰──────────────────────────────╯

# ArgoCD admin password - get it with:
# kubectl get secret argocd-initial-admin-secret -n argocd -o jsonpath='{.data.password}' | base64 -d
ARGOCD_PASSWORD=<your-argocd-password>

# ╭──────────────────────────────────╮
#  ☁️ Oracle Cloud (OCI) credentials
# ╰──────────────────────────────────╯

# Full domain or subdomain where app runs - automatically taken from APP_DOMAIN above
TF_VAR_app_domain=${APP_DOMAIN}

# OCI Console → top right avatar → Tenancy: <name> → OCID
TF_VAR_tenancy_ocid=ocid1.tenancy.oc1..your_tenancy_ocid

# OCI Console → My Profile → User Information → OCID
TF_VAR_user_ocid=ocid1.user.oc1..your_user_ocid

# OCI Console → My Profile → API Keys → copy fingerprint (format: xx:xx:xx...)
TF_VAR_fingerprint=xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx

# Path to OCI API private key on your local machine (WSL path)
TF_VAR_private_key_path=~/.oci/oci_api_key.pem

# OCI Console → Compute → Instances → your VM → Region
# e.g. eu-frankfurt-1, us-ashburn-1, uk-london-1
TF_VAR_region=eu-frankfurt-1

# OCI Console → Identity & Security → Compartments → your compartment → OCID
TF_VAR_compartment_ocid=ocid1.compartment.oc1..your_compartment_ocid

# Your SSH public key - run: cat ~/.ssh/id_ed25519.pub
TF_VAR_ssh_public_key=$(cat ~/.ssh/id_ed25519.pub)

# Your IP(s) allowed to access SSH (22) and Kubernetes API (6443) - google "what is my ip"
# Single IP:   ["YOUR_IP/32"]
# Multiple IPs: ["HOME_IP/32","WORK_IP/32"]
TF_VAR_allowed_cidr=["YOUR_PUBLIC_IP/32"]

# OCI Console → Compute → Instances → your VM → Shape (e.g. VM.Standard.A1.Flex)
TF_VAR_vm_shape=VM.Standard.A1.Flex
TF_VAR_vm_ocpus=2
TF_VAR_vm_memory_gb=12

# Internal network ranges - change only if they conflict with your existing network
TF_VAR_vcn_cidr=10.0.0.0/16
TF_VAR_subnet_cidr=10.0.1.0/24

# ╭──────────────────╮
#  🌩️ Cloudflare DNS
# ╰──────────────────╯
#
# dash.cloudflare.com → My Profile → API Tokens → Create Token → Edit zone DNS
# dash.cloudflare.com → Your Domain → Overview → Zone ID (right column)
#
TF_VAR_cloudflare_api_token=<your-cloudflare-api-token>
TF_VAR_cloudflare_zone_id=<your-cloudflare-zone-id>

# ╭───────────╮
#  🤖 Ansible
# ╰───────────╯
ANSIBLE_USER=ubuntu
ANSIBLE_SSH_KEY=~/.ssh/id_ed25519

# ╭──────────────────────────────────────────────────╮
#  💾 Velero backups (OCI Object Storage, S3-compat)
# ╰──────────────────────────────────────────────────╯

# Bucket name for Velero backups - create in OCI Console → Object Storage → Buckets
TF_VAR_velero_bucket=<your-velero-bucket>

# Your OCI account namespace - NOT the bucket name!
# Find it: OCI Console → Object Storage → Buckets → top right corner
OCI_NAMESPACE=<your-oci-namespace>

# OCI Console → My Profile → Customer Secret Keys → Generate secret key
# ⚠️ Secret key is shown only once - copy it immediately!
VELERO_SECRET_KEY=<your-oci-secret-key>
VELERO_ACCESS_KEY=<your-oci-access-key>

# Auto-composed from OCI_NAMESPACE and TF_VAR_region - no need to change
VELERO_S3_URL=https://${OCI_NAMESPACE}.compat.objectstorage.${TF_VAR_region}.oraclecloud.com

# ╭───────────────────────────────────────────────╮
#  🗄️ Terraform remote state (OCI Object Storage)
# ╰───────────────────────────────────────────────╯

# OCI Object Storage bucket for storing terraform.tfstate - create in OCI Console → Object Storage → Buckets
TF_BACKEND_BUCKET=<your-terraform-bucket>

# Auto-composed from OCI_NAMESPACE and TF_VAR_region - no need to change
TF_BACKEND_ENDPOINT=https://${OCI_NAMESPACE}.compat.objectstorage.${TF_VAR_region}.oraclecloud.com

# OCI Console → My Profile → Customer Secret Keys → Generate
# ⚠️ Secret key is shown only once - copy it immediately!
TF_BACKEND_SECRET_KEY=<your-oci-secret-key>
TF_BACKEND_ACCESS_KEY=<your-oci-access-key>

# ╭───────────────────────────────╮
#  🔱 Atlantis - Terraform GitOps
# ╰───────────────────────────────╯
ATLANTIS_REPO_WHITELIST=github.com/${GITHUB_USERNAME}/${GITHUB_REPO}

# GitHub → Settings → Developer settings → Personal access tokens → Fine-grained
# Permissions: Pull requests (read/write), Commit statuses (read/write), Contents (read)
ATLANTIS_GH_TOKEN=github_pat_...

# Generate: openssl rand -hex 32 - must match GitHub webhook secret
ATLANTIS_GH_WEBHOOK_SECRET=<your-webhook-secret>
