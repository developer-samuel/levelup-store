# Production overrides for Kubernetes
# Copy to .env.production, then from project root:
#   make -C infrastructure secrets

# Production domain - no protocol, no trailing slash
APP_DOMAIN=<your-app-domain>

# K8s service names differ from Docker Compose
DB_HOST=levelup-store-postgresql
REDIS_HOST=levelup-store-redis-master
RABBITMQ_HOST=levelup-store-rabbitmq

# Public URLs differ from localhost
MERCURE_PUBLIC_URL=https://${APP_DOMAIN}/.well-known/mercure
MINIO_PUBLIC_URL=https://minio.${APP_DOMAIN}
