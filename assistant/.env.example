# Docker (Mac/Windows): http://host.docker.internal:11434 | Production: http://ollama:11434
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mistral:7b

# Model for generating embeddings (RAG)
OLLAMA_EMBED_MODEL=nomic-embed-text

# Allowed CORS origins (comma-separated)
# Single:   https://yourdomain.com
# Multiple: https://domain1.com,https://domain2.com
CORS_ORIGINS=*

# Production: http://chromadb:8000
CHROMA_HOST=http://localhost:8000

# Same credentials as the Symfony app - must match docker-compose postgres service
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=levelup_store
DB_USERNAME=postgres
DB_PASSWORD=secret
DATABASE_URL=postgresql://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_DATABASE}

# Same credentials as the root .env - must match docker-compose redis service
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}

# Sentry
SENTRY_DSN=
